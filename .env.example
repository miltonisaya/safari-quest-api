SERVER_PORT=8080
GIN_MODE=debug
DB_STRING=postgres://user:password@localhost:5432/safari_quest?sslmode=disable
JWT_SECRET=change-me-to-a-long-random-secret
SWAGGER_HOST=localhost:8080

SEED=false
# Demo tour companies and packages for the public site (local development only)
SEED_DEMO=false
ADMIN_EMAIL=super@safariquest.com
ADMIN_DEFAULT_PASSWORD=Admin@1234

GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://user:password@localhost:5432/safari_quest?sslmode=disable
GOOSE_MIGRATION_DIR=./migrations

# Website address used in emailed links
APP_URL=http://localhost:4200
# Outgoing email (password reset). Leave SMTP_HOST empty in development to
# write emails, including reset links, to the server log instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=SafariQuest <no-reply@safariquest.com>

# Private files such as travellers' ID copies; never served publicly
PRIVATE_UPLOAD_DIR=private_uploads
